# Public — exposed to browser
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-me

# Server-only — never commit real values
SUPABASE_SERVICE_ROLE_KEY=replace-me
DATABASE_URL=postgres://postgres:postgres@localhost:54322/postgres
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Phase 2 — transcript fallback (GA3 path D)
# Create a free Deepgram account at https://console.deepgram.com to obtain a key.
# Budget cap: ~30 episodes × ~$0.77 worst-case = ~$23 total Phase 2 burn.
DEEPGRAM_API_KEY=
# Phase 2 — pg_cron oEmbed handler shared secret (ADMN-08)
CRON_SECRET=

# Phase 3 — swap candidate strictness (SWAP-02). Default 0.7 (production) requires
# substantively different mechanisms via cosine distance. Lower for dev seeds that
# cluster tighter (set to 0.3 against the 12-template seed to see Swap return results).
SWAP_MIN_COS_DISTANCE=0.7
