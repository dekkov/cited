# Cited Docker Compose — environment variables
#
# Copy this file to docker/.env and fill in the values before running
# ./scripts/dev-up.sh
#
# JWT generation
# ---------------
# GOTRUE_JWT_SECRET is the signing secret for all JWTs.
# SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY must be JWTs signed
# with GOTRUE_JWT_SECRET and the following payloads:
#
#   anon key:         { "role": "anon", "iss": "supabase" }
#   service_role key: { "role": "service_role", "iss": "supabase" }
#
# Official generator: https://supabase.com/docs/guides/self-hosting/docker#generate-api-keys
# (Use the HS256 algorithm and the secret below.)

GOTRUE_JWT_SECRET=super-secret-jwt-token-with-at-least-32-characters

# Replace these with locally generated JWTs (see instructions above):
SUPABASE_ANON_KEY=replace-with-locally-generated-jwt
SUPABASE_SERVICE_ROLE_KEY=replace-with-locally-generated-jwt
